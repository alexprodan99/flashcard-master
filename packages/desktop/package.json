{
  "name": "@flashcard-master/desktop",
  "version": "1.0.1",
  "description": "Cross-platform Desktop Application for Flashcard Master",
  "author": "Ionut-Alexandru Prodan <prodanalexandru580@gmail.com>",
  "homepage": "https://github.com/alexprodan99/flashcard-master",
  "license": "AGPL-3.0",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "type": "module",
  "files": [
    "dist",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --dir",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@flashcard-master/adapters": "1.0.1",
    "@flashcard-master/cli": "1.0.1",
    "@flashcard-master/core": "1.0.1",
    "@flashcard-master/web": "1.0.1",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
