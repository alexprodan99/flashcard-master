{
  "name": "flashcard-master",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node packages/cli/dist/bin.js serve",
    "cli": "node packages/cli/dist/bin.js",
    "build": "npm run build -w @flashcard-master/core && npm run build -w @flashcard-master/adapters && npm run build -w @flashcard-master/web && npm run build -w @flashcard-master/cli",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint packages/*/src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "clean": "rimraf packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8"
  }
}
